# Copy to .env to override. Every value here is optional — with no .env at all
# the app runs against the in-browser demo backend, which is the intended way to
# explore this repo.

# Where the FastAPI backend lives. If nothing answers here, the dashboards fall
# back to demo data automatically (see src/services/api.js).
VITE_API_BASE_URL=http://localhost:8000

# Set to 1 to skip the backend entirely and always use demo data. Useful when a
# backend is running but you want the deterministic demo dataset.
VITE_DEMO_MODE=0
