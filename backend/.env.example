# Copy to backend/.env and fill in.
#
# The backend is OPTIONAL. The frontend serves demo data on its own, so you only
# need this if you want the real API. It requires your own Supabase project —
# the original one is gone, and no credentials are distributed with this repo.
#
# Setup order:
#   1. Create a Supabase project.
#   2. Run backend/supabase/schema.sql in the SQL editor.
#   3. Fill in the values below.
#   4. python backend/seed_data.py
#   5. uvicorn app.main:app --reload --app-dir backend

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service-role key. Bypasses row-level security — server-side only, never ship
# this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed when DEV_AUTH=0.
SUPABASE_JWT_SECRET=

# ── Authentication ────────────────────────────────────────────────────────────
# 1 (default) serves every request as a fixed demo user for whichever role the
# endpoint asks for. There is no login. This is how the project was demoed and
# it leaves the API completely unauthenticated.
#
# 0 restores real Supabase token verification. That path has not been exercised
# since March 2026 — treat it as untested.
#
# Never run a public deployment with DEV_AUTH=1.
DEV_AUTH=1

# ── Models ────────────────────────────────────────────────────────────────────
# Both are optional. When a .pkl is missing the predictor falls back to the
# rule-based logic in app/ml.py, which is what the demo uses. Train them with
# the scripts in backend/ml/ if you have the source data.
RISK_MODEL_PATH=backend/app/ml_model.pkl
RISK_MODEL_VERSION=decision-tree-v1
ECLAMPSIA_MODEL_PATH=backend/app/eclampsia_model.pkl
ECLAMPSIA_MODEL_VERSION=eclampsia-v1
